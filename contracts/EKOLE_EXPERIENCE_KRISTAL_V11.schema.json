{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekole:kristal-experience:2.0-proposition",
  "title": "Ekole · Contrat d'expérience d'apprentissage dans un Kristal",
  "type": "object",
  "required": ["format", "kristal_id", "statut", "source", "progression_enfant", "modalite_evaluation", "preuves_de_maitrise", "limitations"],
  "properties": {
    "format": {"const": "ekole.kristal-experience/2.0-proposition"},
    "kristal_id": {"type": "string", "pattern": "^qc-pri-[a-z]+-[0-9]{3}$"},
    "statut": {"const": "prototype_revue_pedagogique_requise"},
    "source": {"type": "object", "required": ["contrat", "objectif_observable", "preuve_attendue", "concepts"], "properties": {
      "contrat": {"const": "authoring/CONTRAT_PEDAGOGIQUE.json"},
      "objectif_observable": {"type": "string", "minLength": 10},
      "preuve_attendue": {"type": "string", "minLength": 10},
      "concepts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }},
    "progression_enfant": {"type": "object", "required": ["decouvrir", "essayer", "expliquer", "explorer"],
      "properties": {
        "decouvrir": {"$ref": "#/$defs/phase"},
        "essayer": {"$ref": "#/$defs/phase"},
        "expliquer": {"$ref": "#/$defs/phase"},
        "explorer": {"$ref": "#/$defs/phase"}
      }, "additionalProperties": false},
    "modalite_evaluation": {"enum": ["exactitude_mathematique", "interpretation_textuelle", "enquete_scientifique", "performance_observee"]},
    "outils_interactifs": {"type": "array", "items": {"type": "object", "required": ["id", "statut"], "properties": {"id": {"type": "string"}, "statut": {"const": "entrainement_candidat_non_certifie"}}}},
    "preuves_de_maitrise": {"type": "object", "required": ["remplacee_par_atelier", "decision"], "properties": {"remplacee_par_atelier": {"const": false}, "decision": {"const": "revue_humaine_requise"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"phase": {"type": "object", "required": ["titre_enfant", "consigne_enfant", "statut_validation"], "properties": {"titre_enfant": {"type": "string", "minLength": 5}, "consigne_enfant": {"type": "string", "minLength": 20}, "statut_validation": {"type": "string"}}}}
}
