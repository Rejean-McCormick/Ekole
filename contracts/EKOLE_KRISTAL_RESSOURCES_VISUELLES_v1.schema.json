{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ekole.local/contracts/kristal-ressources-visuelles-v1",
  "title": "Ekole · couche conceptuelle d'image dans un Kristal",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "kristal_id", "source", "titre_source", "politique", "regle_image_manquante", "regle_image_existante", "liens_bibliotheque", "statut", "visuels"],
  "properties": {
    "format": {"const": "ekole.kristal-visual-layer/1.0"},
    "kristal_id": {"type": "string", "pattern": "^qc-pri-[a-z]+-[0-9]{3}$"},
    "source": {
      "type": "object",
      "required": ["contrat", "parcours", "objectif_id", "objectif_observable", "concepts"],
      "properties": {
        "contrat": {"type": "string"},
        "parcours": {"type": "string"},
        "objectif_id": {"type": "string"},
        "objectif_observable": {"type": "string", "minLength": 12},
        "concepts": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "titre_source": {"type": "string"},
    "politique": {"type": "string"},
    "regle_image_manquante": {"type": "string"},
    "regle_image_existante": {"type": "string"},
    "liens_bibliotheque": {"type": "object"},
    "statut": {"type": "string"},
    "visuels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slot", "placement", "role", "concept", "prompt_conceptuel", "texte_alternatif", "fichier_preferentiel", "formats_acceptes", "statut", "outils_associes", "verification_pedagogique"],
        "properties": {
          "slot": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,48}$"},
          "placement": {"enum": ["decouvrir", "essayer", "explorer"]},
          "role": {"type": "string"},
          "concept": {"type": "string"},
          "prompt_conceptuel": {"type": "string", "minLength": 60},
          "texte_alternatif": {"type": "string"},
          "fichier_preferentiel": {"type": "string", "pattern": "^experience/images/[a-z][a-z0-9_-]+\\.webp$"},
          "formats_acceptes": {"type": "array", "items": {"enum": ["webp", "png", "jpg", "jpeg"]}},
          "dimensions": {"type": "object"},
          "statut": {"type": "string"},
          "outils_associes": {"type": "array"},
          "verification_pedagogique": {"type": "string"},
          "note_exactitude": {"type": "string"},
          "ancrage_contenu": {"type": "object"}
        }
      }
    }
  }
}
