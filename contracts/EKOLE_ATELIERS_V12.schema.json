{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ekole — contrat des micro-mondes Kristal v12",
  "type": "object",
  "required": [
    "format",
    "kristal_id",
    "source_immutable",
    "micro_mondes",
    "evaluation_et_decision",
    "teacher_review"
  ],
  "properties": {
    "format": {
      "const": "ekole.kristal-atelier-v12/1.0"
    },
    "kristal_id": {
      "pattern": "^qc-pri-[a-z]+-[0-9]{3}$"
    },
    "statut": {
      "const": "prototype_revue_pedagogique_requise"
    },
    "micro_mondes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "instruction",
          "parameters",
          "evaluation",
          "source_review"
        ]
      }
    }
  },
  "additionalProperties": true
}
