{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ekole:microlab:0.1-draft",
  "title": "Ekole MiniLab public practice catalogue — not an examination bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "count", "items", "description", "source"],
  "properties": {
    "format": {"const": "ekole.microlab-catalog/0.1"},
    "description": {"type": "string", "minLength": 10},
    "source": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 1},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "instruction", "parameters", "source_kristal_id", "association_status", "validation_mode", "status", "hints"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]{3,48}$"},
        "type": {"enum": ["jetons", "fraction", "droite", "ordonner", "associer", "classer", "grille", "estimer", "suite"]},
        "title": {"type": "string", "minLength": 3},
        "instruction": {"type": "string", "minLength": 8},
        "parameters": {"type": "object", "minProperties": 1},
        "source_kristal_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^qc-pri-[a-z]+-[0-9]{3}$"}]},
        "association_status": {"enum": ["generique_sans_lien_cours", "illustration_candidate_non_validee"]},
        "validation_mode": {"const": "deterministic_practice"},
        "status": {"const": "prototype_revue_humaine"},
        "hints": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 8}}
      }
    }
  }
}
