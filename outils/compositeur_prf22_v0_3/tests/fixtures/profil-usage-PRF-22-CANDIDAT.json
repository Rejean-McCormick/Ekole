{
  "id": "PRF-22",
  "slug": "situation-pedagogique-orchestrable",
  "name": "Orchestrable Learning Situation",
  "summary": "Compose a situated learning challenge from independently owned activity, knowledge, context and collaboration references, then derive teacher-reviewed plans for varying group sizes.",
  "primary_archetype": "composition-hybride",
  "supporting_archetypes": [
    "parcours-pedagogique",
    "referentiel-semantique",
    "univers-oeuvres-medias",
    "modele-multiplexe",
    "simulation-transition",
    "registre-evenementiel"
  ],
  "visual_pattern": "network",
  "secondary_patterns": [
    "branching",
    "multilayer"
  ],
  "situational_schema": "Situation blueprint references independent activity and objective catalogues, a cultural/historical/fictional context, role and dependency graphs, and organization rules; execution and student evidence are external.",
  "use_cases": [
    "reusable pedagogical situation",
    "narrative classroom mission",
    "solo or collaborative classroom workshop"
  ],
  "inputs": [
    "versioned learning-objective references",
    "versioned activity references",
    "context references and provenance",
    "collaboration templates",
    "resource/capacity constraints",
    "teacher review"
  ],
  "outputs": [
    "design-only situation blueprint",
    "derived organization candidates",
    "review checklist and export proposal"
  ],
  "boundaries": [
    "No canonical ownership of external learning objects or cultural claims",
    "No inferred equivalence of exercises after contextualization",
    "No student identity, enrolment, real-world permissions or scores",
    "A blueprint is not a deployed Orgo World or an authorized Konnaxion project",
    "Teachers approve cultural and pedagogical adaptations and the final session plan"
  ],
  "assemblage_reference": "situation-pedagogique-orchestrable",
  "usage_family": "learning",
  "domain": "education",
